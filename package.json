{
  "name": "mosslight",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "苔光守夜 — an original, dependency-free browser survival game",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
